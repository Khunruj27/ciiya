# Face worker image.
#
# Unlike the photo worker (Alpine + sharp, which ships musl prebuilts), the
# face worker pulls in @tensorflow/tfjs-node — whose native addon is built for
# glibc — and node-canvas, which needs the Cairo/Pango/JPEG/GIF/SVG libraries.
# So this image is based on Debian (glibc) and installs those system libs.
#
# Node 22 (LTS), not 24: node-canvas and tfjs-node ship prebuilt native addons
# for Node 22, so npm install uses those instead of compiling canvas from
# source on a bleeding-edge runtime (a common cause of a failed build). tsx
# runs the worker either way, and Node 22 has the global WebSocket that
# @supabase/supabase-js realtime needs.
FROM node:22-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production

# node-canvas build/runtime dependencies (per the node-canvas Debian docs).
# tfjs-node ships a prebuilt glibc binary, so it needs no extra system libs.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      python3 \
      pkg-config \
      libcairo2-dev \
      libpango1.0-dev \
      libjpeg-dev \
      libgif-dev \
      librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./

# npm install (not ci): it re-resolves the platform-specific optional native
# deps for this Linux image, matching the reasoning in Dockerfile.worker.
RUN npm install

COPY . .

CMD ["npm", "run", "worker:faces"]
