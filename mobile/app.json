{
  "expo": {
    "name": "Ciiya",
    "slug": "ciiya",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ciiya-icon.png",
    "scheme": "ciiya",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/ciiya-icon.png",
      "bundleIdentifier": "app.ciiya.mobile",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f8f6f1",
        "foregroundImage": "./assets/images/ciiya-adaptive-foreground.png",
        "monochromeImage": "./assets/images/ciiya-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.ciiya.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/ciiya-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f6f1",
          "image": "./assets/images/ciiya-splash.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ciiya uses your photo library so you can pick photos to upload to an album.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-sharing",
        {
          "ios": { "enabled": false },
          "android": { "enabled": false }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
