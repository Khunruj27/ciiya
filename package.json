{
  "name": "ciiya",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typegen": "next typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "check:env": "node scripts/check-env-example.mjs",
    "check": "npm run check:env && npm run lint && npm run typecheck && npm run build",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:storage": "npm run test:storage:adapter && npm run test:storage:schema && npm run test:storage:worker && npm run test:storage:download && npm run test:storage:deletion && npm run test:storage:camera && npm run test:storage:phase10 && npm run test:storage:phase11 && npm run test:storage:phase12 && npm run test:storage:phase13 && npm run test:storage:phase14 && npm run test:storage:phase15",
    "test:storage:adapter": "node --import tsx scripts/test-storage-adapter.ts",
    "test:storage:schema": "node scripts/test-storage-schema.mjs",
    "test:storage:worker": "node --import tsx scripts/test-photo-worker-storage.ts",
    "test:storage:download": "node --import tsx scripts/test-photo-download-storage.ts",
    "test:storage:deletion": "node --import tsx scripts/test-storage-deletion.ts",
    "test:storage:camera": "node --import tsx scripts/test-camera-storage.ts",
    "test:storage:phase10": "node --import tsx scripts/test-phase10-storage.ts",
    "test:storage:phase11": "node --import tsx scripts/test-storage-consistency.ts",
    "test:storage:phase12": "node --import tsx scripts/test-dual-provider-reads.ts",
    "test:storage:phase13": "node --import tsx scripts/test-photo-storage-migration.ts",
    "test:storage:phase14": "node --import tsx scripts/test-r2-production-validation.ts",
    "test:storage:phase15": "node --import tsx scripts/test-supabase-source-cleanup.ts",
    "worker:photos": "tsx workers/photo-worker.ts",
    "worker:faces": "tsx workers/face-worker.ts",
    "worker:camera": "tsx workers/camera-live-import-worker.ts",
    "worker:queue-consistency": "tsx workers/queue-consistency-worker.ts",
    "worker:storage-consistency": "tsx workers/storage-consistency-worker.ts",
    "cleanup:orphans": "tsx scripts/cleanup-orphan-files.ts",
    "cleanup:jobs": "tsx scripts/cleanup-old-jobs.ts",
    "cleanup:all": "npm run cleanup:orphans && npm run cleanup:jobs",
    "storage:cleanup": "tsx scripts/storage-cleanup-cron.ts",
    "storage:retry-deletions": "tsx scripts/retry-storage-deletions.ts",
    "storage:migrate:r2": "tsx scripts/migrate-supabase-to-r2.ts",
    "storage:validate:r2": "tsx scripts/validate-r2-production.ts",
    "storage:cleanup:supabase-sources": "tsx scripts/cleanup-migrated-supabase-sources.ts",
    "billing:cron": "tsx scripts/billing-cron.ts",
    "health:check": "tsx scripts/system-health-check.ts",
    "retry:failed": "tsx scripts/retry-failed-jobs.ts",
    "maintenance:check": "npm run health:check",
    "maintenance:retry": "npm run retry:failed",
    "maintenance:cleanup": "tsx scripts/maintenance-cleanup-cron.ts",
    "maintenance:all": "npm run health:check && npm run retry:failed && npm run storage:retry-deletions && npm run storage:cleanup && npm run maintenance:cleanup",
    "maintenance": "tsx scripts/auto-maintenance.ts",
    "faces:cluster": "tsx scripts/cluster-faces.ts",
    "simulator": "open -a Simulator && next dev --webpack -H 0.0.0.0",
    "ios": "npm run simulator"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "bcryptjs": "^3.0.3",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "form-data": "^4.0.6",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "next": "16.3.4",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "sharp": "^0.35.4",
    "stripe": "^22.0.2",
    "tsx": "^4.21.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-window": "^1.8.8",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@tensorflow/tfjs-node": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "canvas": "^3.2.3"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "postcss": "^8.5.27",
    "@tensorflow/tfjs-node": {
      "adm-zip": "^0.6.1",
      "tar": "^7.5.22",
      "@mapbox/node-pre-gyp": {
        "tar": "^7.5.22"
      }
    }
  }
}
