# Public values for the Ciiya mobile app. Copy to .env.local.
# Use the same Supabase project URL and ANON key the web app exposes to
# browsers. Never put the service role key or any worker secret in a mobile app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Origin of the Ciiya web app (API routes + share links). Defaults to
# https://www.ciiya.app. Point it at a local `npm run dev` server
# (http://localhost:3000) to test against unreleased API changes.
# EXPO_PUBLIC_SITE_URL=

# Development only: run on in-memory sample data, no account or network.
# EXPO_PUBLIC_DEMO=1
