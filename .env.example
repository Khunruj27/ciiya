# -----------------------------------------------------------------------------
# Required: web application and Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production for worker/admin routes. Use long, independent values.
WORKER_SECRET=
ADMIN_API_SECRET=
CRON_SECRET=

# Comma-separated email addresses allowed to open /admin.
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Monitoring (optional)
# -----------------------------------------------------------------------------
# HTTPS endpoint that receives sanitized server error events. Without this,
# events are still emitted as structured Vercel/Railway logs.
ERROR_MONITORING_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Stripe billing (required only when billing is enabled)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Photo worker tuning (optional; defaults shown)
# -----------------------------------------------------------------------------
WORKER_LIMIT=2
WORKER_POLL_INTERVAL=2000
PHOTO_JOB_CLAIM_BATCH=4
PHOTO_JOB_MAX_PER_ALBUM=1
SHARP_CONCURRENCY=1
SHARP_CACHE_MEMORY=64
SHARP_CACHE_FILES=0
SHARP_CACHE_ITEMS=32

# -----------------------------------------------------------------------------
# Face detection, search and clustering (optional; defaults shown)
# -----------------------------------------------------------------------------
FACE_SCAN_ENABLED=true
FACE_WORKER_LIMIT=1
FACE_WORKER_POLL_INTERVAL=2000
FACE_JOB_CLAIM_BATCH=4
FACE_JOB_MAX_PER_ALBUM=1
FACE_SEARCH_THRESHOLD=0.55
FACE_CLUSTER_THRESHOLD=0.52
FACE_CLUSTER_MIN_CONFIDENCE=0.5
FACE_CLUSTER_LIMIT=5000
FACE_CLUSTER_DRY_RUN=true
CLUSTER_ALBUM_ID=

# -----------------------------------------------------------------------------
# Consistency workers (optional; milliseconds)
# -----------------------------------------------------------------------------
QUEUE_CONSISTENCY_INTERVAL=3600000
STORAGE_CONSISTENCY_INTERVAL=60000

# -----------------------------------------------------------------------------
# Cleanup and retry jobs (optional; safe dry-run defaults shown)
# -----------------------------------------------------------------------------
CLEANUP_DRY_RUN=true
CLEANUP_DELETE_CHUNK_SIZE=100
CLEANUP_LIST_LIMIT=1000
CLEANUP_DONE_JOBS_RETENTION_DAYS=14
CLEANUP_FAILED_JOBS_RETENTION_DAYS=45
CLEANUP_WORKER_LOGS_RETENTION_DAYS=30
RETRY_DRY_RUN=true
RETRY_FAILED_PHOTO_LIMIT=100
RETRY_FAILED_FACE_LIMIT=50
STORAGE_CLEANUP_DRY_RUN=true
STORAGE_CLEANUP_LIMIT=20
MAINTENANCE_CLEANUP_DRY_RUN=true
MAINTENANCE_LOG_KEEP_DAYS=14
MAINTENANCE_HEARTBEAT_KEEP_HOURS=24
MAINTENANCE_CLEANUP_LIMIT=100

# -----------------------------------------------------------------------------
# Live camera import (optional)
# -----------------------------------------------------------------------------
GPHOTO_BIN=gphoto2
CAMERA_IMPORT_TEMP_DIR=.ciiya-camera-imports

# -----------------------------------------------------------------------------
# Playwright E2E (optional; authenticated suites skip when credentials are blank)
# -----------------------------------------------------------------------------
E2E_BASE_URL=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_SHARE_TOKEN=

# The hosting platform supplies these automatically; do not copy local values:
# NODE_ENV, CI, VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL,
# RAILWAY_REPLICA_ID
