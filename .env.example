# -----------------------------------------------------------------------------
# Required: web application and Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Object storage migration (Cloudflare R2)
# -----------------------------------------------------------------------------
# Keep `supabase` during the adapter/database preparation phases. Changing this
# value alone must never switch traffic; upload routes also use a separate,
# server-side rollout gate introduced in the browser-upload phase.
STORAGE_DEFAULT_PROVIDER=supabase
# Phase 4 rollout gate. Keep false until the Phase 3 migration is deployed,
# R2 CORS/public delivery are configured, and both provider-aware Photo and
# Face Workers from Phase 6 are deployed together.
R2_UPLOADS_ENABLED=false
# Optional Phase 14 canary allowlist. While non-empty, R2 writes are enabled
# only for these owner UUIDs even when both global upload gates are enabled.
# Leave empty only after canary validation and full-rollout approval.
R2_UPLOAD_CANARY_OWNER_IDS=

# R2 uses its S3-compatible API. These values are server/worker-only: never add
# a NEXT_PUBLIC_ prefix to credentials. R2_PUBLIC_BASE_URL may stay empty while
# R2 traffic is disabled, but is required before Phase 6 processes R2 photos.
# It must expose only approved public asset prefixes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
# Separate Phase 13 write gate. The migration CLI is a read-only dry-run unless
# both --apply is provided and this value is true.
STORAGE_MIGRATION_APPLY_ENABLED=false
# Phase 15 is independently gated. Keep both values disabled/empty during
# migration and observation. Apply additionally requires the --apply flag.
STORAGE_SOURCE_CLEANUP_APPLY_ENABLED=false
STORAGE_SOURCE_CLEANUP_CONFIRM=

# Required in production for worker/admin routes. Use long, independent values.
WORKER_SECRET=
ADMIN_API_SECRET=
CRON_SECRET=

# Comma-separated email addresses allowed to open /admin.
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Monitoring (optional)
# -----------------------------------------------------------------------------
# HTTPS endpoint that receives sanitized server error events. Without this,
# events are still emitted as structured Vercel/Railway logs.
ERROR_MONITORING_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Stripe billing (required only when billing is enabled)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Photo worker tuning (optional; defaults shown)
# -----------------------------------------------------------------------------
WORKER_LIMIT=2
WORKER_POLL_INTERVAL=2000
PHOTO_JOB_CLAIM_BATCH=4
PHOTO_JOB_MAX_PER_ALBUM=1
SHARP_CONCURRENCY=1
SHARP_CACHE_MEMORY=64
SHARP_CACHE_FILES=0
SHARP_CACHE_ITEMS=32

# -----------------------------------------------------------------------------
# Face detection, search and clustering (optional; defaults shown)
# -----------------------------------------------------------------------------
FACE_SCAN_ENABLED=true
FACE_WORKER_LIMIT=1
FACE_WORKER_POLL_INTERVAL=2000
FACE_JOB_CLAIM_BATCH=4
FACE_JOB_MAX_PER_ALBUM=1
FACE_SEARCH_THRESHOLD=0.55
FACE_CLUSTER_THRESHOLD=0.52
FACE_CLUSTER_MIN_CONFIDENCE=0.5
FACE_CLUSTER_LIMIT=5000
FACE_CLUSTER_DRY_RUN=true
CLUSTER_ALBUM_ID=

# -----------------------------------------------------------------------------
# Consistency workers (optional; milliseconds)
# -----------------------------------------------------------------------------
QUEUE_CONSISTENCY_INTERVAL=3600000
STORAGE_CONSISTENCY_INTERVAL=60000
STORAGE_CONSISTENCY_BATCH_SIZE=250
# Read-only one-off audit bounds.
STORAGE_AUDIT_BATCH_SIZE=250
STORAGE_AUDIT_MAX_ROWS=100000

# -----------------------------------------------------------------------------
# Cleanup and retry jobs (optional; safe dry-run defaults shown)
# -----------------------------------------------------------------------------
CLEANUP_DRY_RUN=true
CLEANUP_STORAGE_PROVIDER=supabase
CLEANUP_STORAGE_BUCKET=albums
CLEANUP_STORAGE_PREFIX=
CLEANUP_DELETE_LIMIT=100
CLEANUP_SCAN_LIMIT=10000
CLEANUP_DELETE_CHUNK_SIZE=100
CLEANUP_DONE_JOBS_RETENTION_DAYS=14
CLEANUP_FAILED_JOBS_RETENTION_DAYS=45
CLEANUP_WORKER_LOGS_RETENTION_DAYS=30
RETRY_DRY_RUN=true
RETRY_FAILED_PHOTO_LIMIT=100
RETRY_FAILED_FACE_LIMIT=50
STORAGE_CLEANUP_DRY_RUN=true
STORAGE_CLEANUP_LIMIT=20
STORAGE_CLEANUP_SCAN_LIMIT=10000
STORAGE_CLEANUP_PROVIDER=supabase
STORAGE_CLEANUP_BUCKET=albums
STORAGE_CLEANUP_PREFIX=
# Additional explicit production guard. Keep false until R2 inventory dry-runs
# have been reviewed and the rollout is approved.
STORAGE_CLEANUP_ALLOW_R2_DELETE=false
MAINTENANCE_CLEANUP_DRY_RUN=true
MAINTENANCE_LOG_KEEP_DAYS=14
MAINTENANCE_HEARTBEAT_KEEP_HOURS=24
MAINTENANCE_CLEANUP_LIMIT=100

# -----------------------------------------------------------------------------
# Live camera import (optional)
# -----------------------------------------------------------------------------
GPHOTO_BIN=gphoto2
CAMERA_IMPORT_TEMP_DIR=.ciiya-camera-imports

# -----------------------------------------------------------------------------
# Playwright E2E (optional; authenticated suites skip when credentials are blank)
# -----------------------------------------------------------------------------
E2E_BASE_URL=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_SHARE_TOKEN=

# The hosting platform supplies these automatically; do not copy local values:
# NODE_ENV, CI, VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL,
# RAILWAY_REPLICA_ID
